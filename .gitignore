# --- Hugo build output & caches (regenerated by `hugo`) ---
/public/
/resources/_gen/
/.hugo_build.lock
/assets/jsconfig.json
hugo_stats.json

# --- Hugo binaries, if ever dropped in the repo ---
hugo
hugo.exe
hugo.darwin
hugo.linux

# --- Node (only if a theme/tooling ever needs it) ---
node_modules/
npm-debug.log*
yarn-error.log*

# --- Editors / IDEs ---
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*~

# --- OS cruft ---
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# --- Local secrets / env ---
.env
.env.local

# --- Raw camera files: keep web-sized copies in content/, not originals ---
*.RW2
*.CR2
*.CR3
*.NEF
*.ARW
*.DNG
